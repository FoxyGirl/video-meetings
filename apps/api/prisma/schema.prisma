generator client {
  provider     = "prisma-client"
  output       = "./generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  password         String
  createdAt        DateTime  @default(now())
  username         String?
  avatarPath       String?
  avatarMimeType   String?
  avatarUploadedAt DateTime?
  meetings         Meeting[]
}

model Meeting {
  id               String    @id @default(uuid())
  title            String
  date             DateTime
  participants     String[]
  organizerId      String
  organizer        User      @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())
  fileOriginalName String?
  filePath         String?
  fileMimeType     String?
  fileSize         Int?
  fileUploadedAt   DateTime?
}
