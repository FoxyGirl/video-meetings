generator client {
  provider     = "prisma-client"
  output       = "./generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TranscriptionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  password         String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt
  username         String?
  avatarPath       String?
  avatarMimeType   String?
  avatarUploadedAt DateTime?
  meetings         Meeting[]
}

model Meeting {
  id           String        @id @default(uuid())
  title        String
  date         DateTime
  participants String[]
  organizerId  String
  organizer    User          @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt
  files        MeetingFile[]

  @@index([organizerId])
}

model MeetingFile {
  id                     String               @id @default(uuid())
  meetingId              String
  meeting                Meeting              @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  originalName           String
  filePath               String
  mimeType               String
  size                   Int
  uploadedAt             DateTime
  transcriptionStatus    TranscriptionStatus?
  transcriptionText      String?
  transcriptionUpdatedAt DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @default(now()) @updatedAt

  @@index([meetingId])
}
