DATABASE_URL=postgresql://postgres:postgres@localhost:5432/video_meetings_test
JWT_SECRET=local-dev-only-secret-do-not-use-in-production
UPLOAD_DIR=uploads/e2e-test
AVATAR_UPLOAD_DIR=uploads/avatars-e2e-test
# Lowered from the 500 MB production default so meeting-file-multi-upload's
# own oversized-file test doesn't need to allocate hundreds of MB just to
# trip the limit — same reasoning as OVERSIZED_AVATAR_BYTES in
# user-avatar.e2e-spec.ts. Every other fixture this suite uploads
# (short-speech.mp3 is the largest, ~17 KB) stays far under this.
MAX_UPLOAD_FILE_SIZE_BYTES=1048576
# Off by default: every other e2e spec uploads synthetic, non-media bytes
# and would otherwise pay for a doomed transcription attempt on every
# upload call. meeting-file-transcription.e2e-spec.ts turns it back on for
# itself — see apps/api/src/meetings/transcription/whisper.constants.ts.
TRANSCRIPTION_ENABLED=false
# GEMINI_API_KEY explicitly blanked, not just omitted: isSummaryGenerationEnabled()
# (src/meetings/summary/summary.constants.ts) gates on its mere presence, so
# every e2e spec exercises the "no generation attempted" path by default —
# real transcription completing (any real-Whisper spec, not just the
# summary-specific ones) fires MeetingSummaryTriggerService.maybeTrigger()
# regardless of which test is running. jest-e2e.setup.ts loads this file
# first, then falls back to .env for anything still unset (e.g.
# ANTHROPIC_API_KEY, read only by agent-sdk.e2e-spec.ts's own always-skipped
# test) — dotenv's config() never overrides a key already present in
# process.env, so an explicit empty value here (unlike merely never setting
# it) is what actually stops a real GEMINI_API_KEY in a developer's local
# .env from leaking into every other spec's process as an uncontrolled real
# network call once transcription completes. Confirmed 2026-08-26: a real
# key in .env made unrelated real-Whisper e2e specs trigger real,
# unmocked Gemini calls as a side effect, causing flaky failures having
# nothing to do with what those tests actually exercise. A real-API e2e
# spec still sets its own value for itself (gemini-api.e2e-spec.ts reads
# .env directly rather than relying on this at all, for exactly this
# reason), same pattern TRANSCRIPTION_ENABLED above and
# agent-sdk.e2e-spec.ts's ANTHROPIC_API_KEY gating already use.
GEMINI_API_KEY=
