DATABASE_URL=postgresql://postgres:postgres@localhost:5432/video_meetings_test
JWT_SECRET=local-dev-only-secret-do-not-use-in-production
UPLOAD_DIR=uploads/e2e-test
AVATAR_UPLOAD_DIR=uploads/avatars-e2e-test
# Off by default: every other e2e spec uploads synthetic, non-media bytes
# and would otherwise pay for a doomed transcription attempt on every
# upload call. meeting-file-transcription.e2e-spec.ts turns it back on for
# itself — see apps/api/src/meetings/transcription/whisper.constants.ts.
TRANSCRIPTION_ENABLED=false
