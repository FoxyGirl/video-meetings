DATABASE_URL=postgresql://postgres:postgres@localhost:5432/video_meetings
JWT_SECRET=local-dev-only-secret-do-not-use-in-production
WEB_ORIGIN=http://localhost:3000

# Optional, both default sensibly if unset — see apps/api/CLAUDE.md's "Meetings" section.
# UPLOAD_DIR=uploads
# MAX_UPLOAD_FILE_SIZE_BYTES=524288000

# Optional, both default sensibly if unset — see src/user/upload/avatar-upload.constants.ts.
# AVATAR_UPLOAD_DIR=uploads/avatars
# MAX_AVATAR_FILE_SIZE_BYTES=5242880

# Optional — meeting summary/action-item/decision generation (see
# src/meetings/summary/summary.constants.ts) is only attempted when this is
# set; get a free-tier key from Google AI Studio.
# GEMINI_API_KEY=
