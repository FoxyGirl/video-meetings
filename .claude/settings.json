{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/stop.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_input.notebook_path // empty' | { read -r f; [ -n \"$f\" ] && npx --no-install prettier --write --ignore-unknown \"$f\"; } 2>/dev/null || true",
            "statusMessage": "Formatting with Prettier..."
          }
        ]
      }
    ]
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": ["Bash(git merge *)", "Bash(gh pr merge *)"],
    "allow": [
      "Edit(*)",
      "Write(*)",
      "Bash(npm run test)",
      "Bash(npm run test:e2e)",
      "Bash(npm run typecheck*)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(npx prisma *)"
    ]
  },
  "enabledMcpjsonServers": ["playwright"]
}
